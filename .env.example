# Onebridge Alliance — variáveis de ambiente
# Copie este arquivo para .env (local) e configure os mesmos valores no painel
# da Vercel (Project → Settings → Environment Variables) para Production,
# Preview e Development.

# SignWell (https://www.signwell.com) — usada por /api/signwell-document
SIGNWELL_API_KEY=
SIGNWELL_TEMPLATE_ID=

# Make.com Custom Webhook — usada por /api/ncnda
MAKE_NCNDA_WEBHOOK_URL=
